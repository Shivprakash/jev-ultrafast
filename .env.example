# Decision backend: typesafe | openrouter | vercel | mithila-clef
JEV_BACKEND=typesafe
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Local Clef (only when JEV_BACKEND=mithila-clef)
# MITHILA_CLEF_BASE_URL=http://gana004:8003/v1
# MITHILA_CLEF_MODEL=/home/shivprakash/mithila/models/clef/Clef-Q4_K_M.gguf
# MITHILA_CLEF_API_KEY=local

# TYPE_TEXT helper — any OpenAI-compatible chat endpoint.
# Cloud example (OpenRouter / Vercel):
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Lab example (mithila-chat on gana005):
# TEXT_MODEL_BASE_URL=http://gana005:8000/v1
# TEXT_MODEL=/home/shivprakash/mithila/models/qwen_chat
# TEXT_MODEL_API_KEY=local

# Switch without losing values:
#   uv run python scripts/backend_preset.py apply mithila-local
#   uv run python scripts/backend_preset.py apply cloud
#   uv run python scripts/backend_preset.py restore
