# Cloud / TypeSafe + Vercel text helper (pre-mithila lab defaults on this machine).
# Apply: uv run python scripts/backend_preset.py apply cloud
# Does not store secrets — existing API keys in .env are left alone.
JEV_BACKEND=typesafe
TYPESAFE_MODEL=jev-latest
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v4/ai
TEXT_MODEL_BASE_URL=https://ai-gateway.vercel.sh/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Clear local-only overrides when restoring cloud
MITHILA_CLEF_BASE_URL=
MITHILA_CLEF_MODEL=
MITHILA_CLEF_API_KEY=
